{
    "name": "sigil-ps",
    "displayName": "SIGIL-PS",
    "icon": "images/logo.jpeg",
    "description": "The approved LLM assistant for NAU's CS 136 course.",
    "version": "1.1.0",
    "publisher": "RESHAPELab",
    "engines": {
        "vscode": "^1.93.0"
    },
    "categories": [
        "AI",
        "Chat"
    ],
    "activationEvents": [
        "onView:sigil-ps.chatView"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "sigil-ps-sidebar",
                    "title": "Sigil",
                    "icon": "images/wand.svg"
                }
            ]
        },
        "views": {
            "sigil-ps-sidebar": [
                {
                    "id": "sigil-ps.chatView",
                    "name": "Chat",
                    "type": "webview",
                    "when": "true"
                }
            ]
        },
        "authentication": [
            {
                "id": "github",
                "label": "GitHub"
            }
        ],
        "commands": [
            {
                "command": "sigil-ps.toggleChat",
                "title": "Toggle Sigil Chat",
                "icon": "$(comment-discussion)",
                "category": "Sigil"
            },
            {
                "command": "sigil-ps.openPersonalization",
                "title": "Open SIGIL-PS Personalization Settings"
            }
        ],
        "keybindings": [
            {
                "command": "sigil-ps.toggleChat",
                "key": "ctrl+shift+s",
                "mac": "cmd+shift+s"
            }
        ],
        "configuration": {
            "title": "SIGIL-PS Settings",
            "properties": {
                "sigil.apiBaseUrl": {
                    "type": "string",
                    "default": "https://sigil-api-cat-test.lemonsand-c67bbaad.westus2.azurecontainerapps.io/api",
                    "scope": "machine",
                    "description": "Base URL for the CAT SIGIL API, including the /api path."
                },
                "sigil.persona": {
                    "type": "string",
                    "enum": [
                        "Default"
                    ],
                    "enumDescriptions": [
                        "The default behavior for Sigil. A friendly computer science tutor intended for novice students, who will provide plenty of direct guidance."
                    ],
                    "default": "Default",
                    "description": "Currently active persona that Sigil will embody in its responses."
                },
                "sigil.personalizeResponses": {
                    "type": "boolean",
                    "default": false,
                    "description": "When enabled, Sigil will attempt to create a personalized prompt when you provide feedback and use it to tailor its responses."
                },
                "sigil.personalizedPrompt": {
                    "type": "string",
                    "default": "",
                    "editPresentation": "multilineText",
                    "description": "Extra preferences that Sigil will use to curate its responses for you."
                },
                "sigil.fieldStudyOptIn": {
                    "type": "boolean",
                    "default": false,
                    "description": "When this option is set to true, you consent that your interactions with SIGIL-PS may be anonymously used in a publication from RESHAPE Lab. You may opt in or out at any time."
                },
                "sigil.developerSettings.test": {
                    "type": "boolean",
                    "default": false,
                    "scope": "machine",
                    "description": "Development setting: when enabled, SIGIL-PS will use the test environment for the backend."
                },
                "sigil.developerSettings.apiUrl": {
                    "type": "string",
                    "default": "",
                    "scope": "machine",
                    "description": "Development setting: custom base URL for the SIGIL-PS API for testing purposes (i.e. localhost). The /api path is added automatically if omitted. Only applies when in test environment."
                }
            }
        },
        "files": {
            "include": [
                "media/**/*"
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint",
        "test": "node ./out/test/runTest.js",
        "package": "vsce package"
    },
    "devDependencies": {
        "@eslint/js": "^9.13.0",
        "@stylistic/eslint-plugin": "^2.9.0",
        "@types/mocha": "^10.0.3",
        "@types/node": "18.x",
        "@types/vscode": "^1.93.0",
        "@vscode/test-electron": "^2.3.6",
        "@vscode/vsce": "^3.7.1",
        "dotenv": "^16.4.7",
        "eslint": "^9.13.0",
        "glob": "^10.3.10",
        "mocha": "^10.2.0",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.16.0"
    },
    "dependencies": {
        "axios": "^1.7.9",
        "uuid": "^11.1.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/RESHAPELab/sigil-ps-vscode"
    }
}
